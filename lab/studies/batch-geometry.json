  "workload": {"queue": "ubq-v8-s4096-v128", "backoff": "yield", "rss_limit_mib": 65536},
  "clusters": ["grace"],
  "throughput": {
    "scenarios": ["Np1c", "16p1c", "1p1c"],
    "batch_sizes": [1, 16, 256, 4096, 16384, [16, 1], [256, 1], [4096, 1], [1, 256], [4096, 256]],
    "replicates": 3
  },
  "memory": {"scenarios": [], "depths": []},
  "deep": {"auto": false},
  "build": {"tests": ["v8::", "bench_harness::hardware"]}
}
